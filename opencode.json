{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "kubernetes": {
      "type": "local",
      "command": ["npx", "-y", "kubernetes-mcp-server@latest", "--read-only"],
      "enabled": true
    }
  },
  "permission": {
    "mcp": {
      "kubernetes_*": "ask",
      "kubernetes_pods_list_in_namespace": "allow"
    }
  }
}
